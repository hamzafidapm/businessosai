# Copy to .env (never commit .env). All secrets live here or in a secret manager.
# Postgres connection string. Local example: postgres://businessos:businessos@localhost:5432/businessos
DATABASE_URL=postgres://businessos:businessos@localhost:5432/businessos
# Random 32+ character secret used to sign session cookies / tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret
# SMTP placeholders (see README "SMTP finding"): NO mail transport is implemented yet,
# so setting these alone does NOT send email. When a transport is wired in, it should use
# these provider-agnostic variables. If unset, dev logs the verification/reset link.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@businessos.example
# App public URL, used only to build dev verification links when SMTP is unset.
APP_URL=http://localhost:3000
# AI: deterministic grounded layer is used by default. LLM is disabled unless BOTH are set,
# and even then it may only rephrase numbers produced by the allowlisted tools — never compute them.
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=
# Rate limits (requests per minute, per IP, per endpoint group)
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=300
RATE_LIMIT_AI=30
